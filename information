 <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Grid ColumnDefinitions="250, *">
        <!-- Боковая панель меню -->
        <Border Grid.Column="0" Background="#2c3e50" Padding="10">
            <StackPanel Spacing="5">
                <TextBlock Text="БИБЛИОТЕКА" Foreground="White" FontSize="20" 
                           FontWeight="Bold" Margin="0,0,0,20" HorizontalAlignment="Center"/>
                
                <Button Content="Книги" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                <Button Content="Читатели" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                <Button Content="Выдача книг" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                <Button Content="Авторы" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                
                <Separator Margin="0,20" Background="Gray"/>
                
                <Button Content="Отчеты" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                <Button Content="Выход" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="#e74c3c"/>
            </StackPanel>
        </Border>

        <!-- Основная область контента -->
        <Grid Grid.Column="1" RowDefinitions="Auto, *">
            <!-- Заголовок текущего раздела -->
            <Border Grid.Row="0" Background="#ecf0f1" Height="50" Padding="15,0">
                <TextBlock Text="Список книг" VerticalAlignment="Center" FontSize="18" FontWeight="SemiBold"/>
            </Border>

            <!-- Здесь будет отображаться таблица с данными (DataGrid) -->
            <DataGrid Grid.Row="1" Margin="10" AutoGenerateColumns="True" IsReadOnly="True" x:Name="MainDataGrid">
                <!-- Сюда потом привяжем данные из твоей БД -->
            </DataGrid>
        </Grid>
    </Grid>
</Window>
