1. Roles (Роли)
id (PK)
name (Библиотекарь, Читатель, Админ)
2. Users (Пользователи)
id (PK)
role_id (FK к Roles.id) — Связь Many-to-One (Многие к Одному)
full_name
email
phone
login
password_hash
registration_date
3. Authors (Авторы)
id (PK)
name
4. Books (Книги — общее описание)
id (PK)
author_id (FK к Authors.id) — Связь Many-to-One (у книги один автор, у автора много книг)
title
isbn
description
year_published
5. BookCopies (Экземпляры книг — конкретные физические книги)
id (PK)
book_id (FK к Books.id) — Связь Many-to-One (у одного описания книги много копий)
inventory_number
status (Доступна, выдана, в ремонте)
shelf_location
6. Loans (Выдачи)
id (PK)
copy_id (FK к BookCopies.id) — Связь Many-to-One
reader_id (FK к Users.id) — Связь Many-to-One
librarian_id (FK к Users.id) — Связь Many-to-One
issue_date
due_date
return_date
status
7. Reservations (Бронирование)
id (PK)
book_id (FK к Books.id) — Связь Many-to-One
reader_id (FK к Users.id) — Связь Many-to-One
reservation_date
expiry_date
is_active
8. Fines (Штрафы)
id (PK)
loan_id (FK к Loans.id) — Связь One-to-One (обычно один штраф на одну просроченную выдачу)
amount
is_paid
created_at



-- 1. Роли
CREATE TABLE roles (
    id INT AUTO_INCREMENT PRIMARY KEY,
    name VARCHAR(50) NOT NULL UNIQUE
);

-- 2. Авторы
CREATE TABLE authors (
    id INT AUTO_INCREMENT PRIMARY KEY,
    name VARCHAR(255) NOT NULL
);

-- 3. Пользователи
CREATE TABLE users (
    id INT AUTO_INCREMENT PRIMARY KEY,
    role_id INT NOT NULL,
    full_name VARCHAR(255) NOT NULL,
    email VARCHAR(100) UNIQUE,
    phone VARCHAR(20),
    login VARCHAR(50) NOT NULL UNIQUE,
    password_hash VARCHAR(255) NOT NULL,
    registration_date TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    -- Явная связь с ролями
    CONSTRAINT fk_user_role FOREIGN KEY (role_id) REFERENCES roles(id)
);

-- 4. Книги (Общее описание)
CREATE TABLE books (
    id INT AUTO_INCREMENT PRIMARY KEY,
    author_id INT NOT NULL,
    title VARCHAR(255) NOT NULL,
    isbn VARCHAR(20) UNIQUE,
    description TEXT,
    year_published INT,
    -- Явная связь с авторами
    CONSTRAINT fk_book_author FOREIGN KEY (author_id) REFERENCES authors(id)
);

-- 5. Экземпляры (Физические копии)
CREATE TABLE book_copies (
    id INT AUTO_INCREMENT PRIMARY KEY,
    book_id INT NOT NULL,
    inventory_number VARCHAR(50) NOT NULL UNIQUE,
    status VARCHAR(50) DEFAULT 'available',
    shelf_location VARCHAR(100),
    -- Явная связь с книгами
    CONSTRAINT fk_copy_book FOREIGN KEY (book_id) REFERENCES books(id)
);

-- 6. Бронирование
CREATE TABLE reservations (
    id INT AUTO_INCREMENT PRIMARY KEY,
    book_id INT NOT NULL,
    reader_id INT NOT NULL,
    reservation_date TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    expiry_date TIMESTAMP NOT NULL,
    is_active BOOLEAN DEFAULT TRUE,
    -- Связи
    CONSTRAINT fk_res_book FOREIGN KEY (book_id) REFERENCES books(id),
    CONSTRAINT fk_res_reader FOREIGN KEY (reader_id) REFERENCES users(id)
);

-- 7. Выдачи (Loans)
CREATE TABLE loans (
    id INT AUTO_INCREMENT PRIMARY KEY,
    copy_id INT NOT NULL,
    reader_id INT NOT NULL,
    librarian_id INT NOT NULL,
    issue_date TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    due_date TIMESTAMP NOT NULL,
    return_date TIMESTAMP,
    status VARCHAR(50) DEFAULT 'active',
    -- Связи
    CONSTRAINT fk_loan_copy FOREIGN KEY (copy_id) REFERENCES book_copies(id),
    CONSTRAINT fk_loan_reader FOREIGN KEY (reader_id) REFERENCES users(id),
    CONSTRAINT fk_loan_librarian FOREIGN KEY (librarian_id) REFERENCES users(id)
);

-- 8. Штрафы
CREATE TABLE fines (
    id INT AUTO_INCREMENT PRIMARY KEY,
    loan_id INT NOT NULL UNIQUE, -- UNIQUE делает связь 1 к 1
    amount DECIMAL(10, 2) NOT NULL,
    is_paid BOOLEAN DEFAULT FALSE,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    -- Связь с выдачей
    CONSTRAINT fk_fine_loan FOREIGN KEY (loan_id) REFERENCES loans(id)
);
